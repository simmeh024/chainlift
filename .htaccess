# Chainlift

# The migration files are applied by migrate.php reading them off disk; there
# is no reason for anyone to fetch them over HTTP.
<FilesMatch "\.sql$">
  Require all denied
</FilesMatch>

# Never serve a config file, even if one is placed here by mistake.
<FilesMatch "^config\.php$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Caching.
#
# JavaScript must revalidate. Only the entry script carries a ?v=; everything
# it imports is a bare specifier like './core/grid.js', so those URLs never
# change. Under a long immutable policy a deploy shipped a NEW entry script
# against CACHED old modules — a mixed build, which fails in stranger ways
# than a wholly stale one. Long caching is only safe with fingerprinted
# filenames, and a no-build-step project does not have them.
#
# Images are different: their filenames are stable and their contents never
# change in place, so they keep the long cache and stay free after first load.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
